
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohoria-portfolio-test",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": false
  }
}